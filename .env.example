# ——— Développement ———
# Sans aucune variable, l'application tourne en local : base PGlite dans .data/pglite (migrée et peuplée
# avec des données de démonstration), fichiers dans .data/uploads, paiements, e-mails, CRM et OCR simulés.
#
# En production, ces variables se renseignent dans Vercel (Settings → Environment Variables), séparément pour
# « Production » et « Preview » : pas à pas dans docs/06-MISE-EN-LIGNE.md.

# ——— Application ———
# Adresse publique (liens des e-mails, retours Stripe et HubSpot). Sur Vercel, si elle est vide, le domaine de
# production ou l'adresse de l'aperçu est utilisé.
APP_URL=http://localhost:3000
# Secret de signature des sessions (obligatoire en production) : openssl rand -base64 48
AUTH_SECRET=
# Clé de chiffrement des jetons CRM, 32 octets en base64 : openssl rand -base64 32
ENCRYPTION_KEY=
# Secret des tâches planifiées : openssl rand -hex 32 (Vercel l'envoie de lui-même au Schedule de vercel.json)
CRON_SECRET=

# ——— Base de données (Supabase, région UE) ———
# Connexion de l'application : pooler Supabase en mode TRANSACTION (port 6543), obligatoire sur Vercel.
# Dashboard → Connect → « Transaction pooler ».
DATABASE_URL=
# Connexion des migrations (npm run db:migrate, lancé à la construction sur Vercel) : pooler en mode SESSION
# (port 5432). Dashboard → Connect → « Session pooler ». À défaut, DATABASE_URL est utilisée.
DATABASE_URL_DIRECT=
# Les noms posés par l'intégration Supabase de Vercel (POSTGRES_URL, POSTGRES_URL_NON_POOLING) sont aussi acceptés.
# RUN_MIGRATIONS=0 pour ne pas appliquer les migrations au démarrage (hors Vercel)
# DB_DRIVER=pglite pour une démo sans Postgres (déconseillé en production)

# ——— Authentification et stockage (Supabase) ———
SUPABASE_URL=
# clé publique (« anon » ou « publishable ») et clé secrète (« service role » ou « secret ») : Project Settings → API Keys
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Buckets Storage à créer : « private » (privé) et « public » (public)

# ——— E-mails (Resend) ——— mise en place : docs/05-EMAILS.md
RESEND_API_KEY=
# adresse d'un domaine vérifié chez Resend (sous-domaine d'envoi conseillé)
EMAIL_FROM=Standby <notifications@notifications.votre-domaine.fr>
# adresse qui reçoit les réponses des utilisateurs (à défaut : SUPPORT_EMAIL)
EMAIL_REPLY_TO=
# reçoit les messages du formulaire de contact
SUPPORT_EMAIL=
# secret de signature du webhook https://<domaine>/api/resend/webhook (whsec_…)
RESEND_WEBHOOK_SECRET=

# ——— Paiements (Stripe Connect) ———
STRIPE_SECRET_KEY=
# deux destinations de webhook sur https://<domaine>/api/stripe/webhook (format Snapshot) :
# « Your account » (paiements, remboursements) et « Connected accounts » (account.updated des commerciaux)
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ——— CRM (HubSpot, application publique OAuth) ———
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ——— Contrôle des SIRET ———
# Facultatif : API Sirene de l'INSEE (portail-api.insee.fr, application « Simple », offre publique par clé).
# Sans clé, ou si l'INSEE ne répond pas, l'API publique Recherche d'entreprises (sans clé) prend le relais.
INSEE_API_KEY=
# INSEE_SIRENE_URL=https://api.insee.fr/api-sirene/3.11

# ——— Lecture des cartes de visite (Claude) ———
ANTHROPIC_API_KEY=
# OCR_MODEL=claude-opus-5-5
